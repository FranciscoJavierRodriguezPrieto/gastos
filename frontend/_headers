# Cabeceras para Cloudflare Pages.
#
# La API tiene las suyas (SecurityHeadersFilter); estas son las del cliente, que es donde
# de verdad importa la CSP: es lo único que se interpone entre un XSS y el token de
# refresco guardado en localStorage.

/*
  # Nada de terceros. Sin 'unsafe-inline' ni 'unsafe-eval': el código es todo propio y
  # en módulos, así que no hace falta ninguna de las dos.
  #
  # connect-src lleva el valor de desarrollo. Al desplegar lo reescribe
  # scripts/preparar-frontend.mjs, que ajusta a la vez este valor y el de config.js:
  # si sólo se cambiara uno, la aplicación llamaría a la API y el navegador bloquearía
  # la petición sin que nada en el servidor lo delatara.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' http://localhost:8080; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  # publickey-credentials-* ya vale 'self' por omision; se escribe para que quede
  # constancia de que las passkeys son de este origen y de ningun iframe ajeno.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), publickey-credentials-get=(self), publickey-credentials-create=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# El armazón lo cachea el service worker, así que el navegador debe revalidar siempre:
# si no, una versión vieja podría quedarse pegada tras un despliegue.
/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/src/*
  Cache-Control: no-cache

# Los dos scripts sueltos de la raíz, por el mismo motivo: config.js lleva la dirección
# de la API —si se queda una versión vieja, la aplicación llama a donde no debe— y
# tema-inicial.js decide con qué tema se pinta la primera pantalla.
/config.js
  Cache-Control: no-cache

/tema-inicial.js
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=604800
